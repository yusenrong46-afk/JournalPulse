# JournalPulse configuration. Copy to `.env` and fill in as needed.
# Everything here is optional — with no values set, the app runs fully offline
# using the local transformer + deterministic coach + catalog recommendations.

# --- Model serving ---------------------------------------------------------
# The trained transformer (~300 MB) is NOT committed to git. For any deployment
# (or a fresh clone), push it to the Hugging Face Hub and point here:
#   huggingface-cli upload <user>/journalpulse-emotion artifacts/models/transformer_model
JOURNALPULSE_HF_MODEL_ID=

# --- Sentiment classifier --------------------------------------------------
# calibrated (default, no key) | llm (LLM replaces the model) | hybrid (blend, recommended with a key)
JOURNALPULSE_CLASSIFIER_MODE=calibrated

# --- LLM (enables hybrid sentiment, the structured coach, and dynamic
#         AI-suggested resource recommendations) -------------------------------
# off (default) | rewrite | structured
JOURNALPULSE_LLM_MODE=off
JOURNALPULSE_LLM_API_KEY=
JOURNALPULSE_LLM_MODEL=
# Defaults to OpenRouter; override for OpenAI, Together, etc.
JOURNALPULSE_LLM_BASE_URL=https://openrouter.ai/api/v1
JOURNALPULSE_LLM_APP_URL=
JOURNALPULSE_LLM_APP_TITLE=JournalPulse

# --- Storage / deployment --------------------------------------------------
JOURNALPULSE_DB_PATH=
# Set on the Streamlit frontend to call a remote API instead of in-process services.
JOURNALPULSE_API_BASE_URL=
JOURNALPULSE_ENV=local
JOURNALPULSE_DEPLOYMENT_MODE=demo
