# JournalPulse research-beta configuration. Never commit real values.

# OpenRouter structured perception layer. Journal requests require ZDR.
JOURNALPULSE_LLM_API_KEY=
JOURNALPULSE_LLM_ENABLED=true
JOURNALPULSE_LLM_MODEL=openai/gpt-5.4-mini
JOURNALPULSE_LLM_BASE_URL=https://openrouter.ai/api/v1
JOURNALPULSE_LLM_ZDR=true
JOURNALPULSE_LLM_TIMEOUT_SECONDS=20

# Supabase Auth and RLS-backed PostgREST persistence.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Local development only.
JOURNALPULSE_DB_PATH=
JOURNALPULSE_ENV=local
JOURNALPULSE_SAVE_RAW_TEXT_DEFAULT=false
JOURNALPULSE_MEMORY_ENABLED=false
JOURNALPULSE_ADAPTIVE_POLICY_ENABLED=false

# Next.js web client.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEV_USER_ID=00000000-0000-4000-8000-000000000001
