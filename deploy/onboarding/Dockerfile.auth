# Auth stand-in for `make onboard` (scripts/onboarding_auth.py). Local environments only.
FROM python:3.12-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir "httpx>=0.27,<1"
COPY scripts/onboarding_auth.py /app/onboarding_auth.py
USER nobody
CMD ["python", "/app/onboarding_auth.py"]
