{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app.py": {
      "maxDuration": 120,
      "includeFiles": "web-dist/**",
      "excludeFiles": "{tests/**,web/{tests,test-results*,playwright-report,node_modules,.next,out}/**,web/{playwright*.config.ts,vitest.config.ts,*.tsbuildinfo},docs/**,artifacts/**,assets/evaluation/**,{build,dist,*.egg-info,.github,.git,.venv}/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
