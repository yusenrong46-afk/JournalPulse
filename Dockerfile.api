FROM python:3.9-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt ./requirements-api.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements-api.txt

COPY src ./src
COPY assets ./assets
# Small, committed artifacts: production metadata + the baseline explainer.
COPY artifacts/models/production.json ./artifacts/models/production.json
COPY artifacts/models/baseline.joblib ./artifacts/models/baseline.joblib
# Tokenizer/config files are committed; model.safetensors (≈300 MB) is NOT in git.
# For deployment, set JOURNALPULSE_HF_MODEL_ID so weights load from the Hugging Face
# Hub. This COPY still succeeds when the local safetensors is absent.
COPY artifacts/models/transformer_model ./artifacts/models/transformer_model

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -fsS "http://localhost:${PORT:-8000}/health" || exit 1

CMD ["sh", "-c", "uvicorn emotion_journal.api:app --host 0.0.0.0 --port ${PORT:-8000}"]
