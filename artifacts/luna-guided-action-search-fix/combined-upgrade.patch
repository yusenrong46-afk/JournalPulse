+        or receipt.conversation_revision != conversation_revision
+        or receipt.issued_at > timestamp + 30
+        or receipt.expires_at <= timestamp
+        or receipt.expires_at - receipt.issued_at != RESOURCE_TOKEN_TTL_SECONDS
