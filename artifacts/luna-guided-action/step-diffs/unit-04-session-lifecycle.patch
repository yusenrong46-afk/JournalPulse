+            id=payload.client_request_id,
+            user_id=auth.user_id,
+            conversation_id=conversation_id,
+            source_entry_id=conversation.source_entry_id,
+            offered_message_id=active_card.offered_message_id if active_card else None,
+            resource=candidate,
