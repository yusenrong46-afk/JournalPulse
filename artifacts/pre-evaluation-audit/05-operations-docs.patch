+        address = ip_address(host)
+    except ValueError:
+        return bool(re.fullmatch(r"[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?", host)) and all(
+            label and len(label) <= 63 and not label.startswith("-") and not label.endswith("-")
+            for label in host.split(".")
